# ─────────────────────────────────────────────
# CULINOVA ERP — Backend environment
# Copy this file to ".env" and fill the values.
# Get Supabase values from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────

PORT=5050

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=YOUR-service-role-secret-key   # server-side only, NEVER expose to frontend
SUPABASE_ANON_KEY=YOUR-anon-public-key

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=8h

# CORS (comma-separated frontend origins — local + all Vercel apps)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://culinova-client.vercel.app,https://culinova-admin.vercel.app,https://culinova-customer.vercel.app,https://culinova-suplier.vercel.app,https://culinova-technician.vercel.app

# CULINOVA EOS knowledge base API — OPTIONAL (auto: production URL on Vercel, localhost:4400 in dev)
# EOS_API_URL=https://culinova-rag-knowledgebase-server.vercel.app

# Must EQUAL the key set on EOS server:
ERP_EOS_INTEGRATION_KEY=
# (fallback name accepted): ERP_INTEGRATION_KEY=

# Postgres connection string — used by npm run migrate only (Supabase → Database → Connection string)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
