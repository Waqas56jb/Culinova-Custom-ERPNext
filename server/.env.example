# ─────────────────────────────────────────────
# CULINOVA ERP — Backend environment
# Copy this file to ".env" and fill the values.
# Get Supabase values from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────

PORT=5050

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=YOUR-service-role-secret-key   # server-side only, NEVER expose to frontend
SUPABASE_ANON_KEY=YOUR-anon-public-key

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=8h

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
